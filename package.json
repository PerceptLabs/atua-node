{
  "name": "@aspect/atua-node",
  "version": "0.1.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:compat-vendor": "vitest run --config vitest.config.compat.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@wasmer/sdk": "^0.10.0",
    "assert": "^2.1.0",
    "events": "^3.3.0",
    "path-browserify": "^1.0.1",
    "punycode": "^2.3.1",
    "querystring-es3": "^0.2.1",
    "readable-stream": "^4.7.0",
    "string_decoder": "^1.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "bytes": "^3.1.2",
    "happy-dom": "^13.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  }
}
